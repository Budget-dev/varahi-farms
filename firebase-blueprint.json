{
  "entities": {
    "ProductReview": {
      "title": "Product Review",
      "description": "Customer product reviews requiring administrative moderation before public display",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique review identifier" },
        "productId": { "type": "string", "description": "Target product identifier" },
        "productName": { "type": "string", "description": "Name of product reviewed" },
        "productImage": { "type": "string", "description": "Thumbnail image URL" },
        "userId": { "type": "string", "description": "Reviewer Firebase Auth UID" },
        "userName": { "type": "string", "description": "Reviewer display name" },
        "userEmail": { "type": "string", "description": "Reviewer email address" },
        "rating": { "type": "integer", "description": "Star rating from 1 to 5" },
        "title": { "type": "string", "maxLength": 200, "description": "Review title" },
        "comment": { "type": "string", "maxLength": 2000, "description": "Detailed review body" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Moderation status" },
        "adminComment": { "type": "string", "description": "Reason or note from admin on moderation decision" },
        "verifiedPurchase": { "type": "boolean", "description": "Whether reviewer purchased product" },
        "helpfulCount": { "type": "integer", "description": "Number of helpful votes" },
        "createdAt": { "type": "string", "description": "ISO timestamp when created" },
        "updatedAt": { "type": "string", "description": "ISO timestamp when updated" }
      },
      "required": ["productId", "userId", "userName", "rating", "title", "comment", "status", "createdAt"]
    }
  },
  "firestore": {
    "/reviews/{reviewId}": {
      "schema": "ProductReview",
      "description": "Stores all customer product reviews subject to administrative moderation"
    }
  }
}
